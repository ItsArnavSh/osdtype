# Copy this file to .env.prod on the EC2 instance and fill in real values.
# Never commit .env.prod. Never paste these values into a chat, issue or log.
#
#   cp deploy/aws/env.example .env.prod
#   chmod 600 .env.prod
#
# Then run compose with:
#   docker compose -f docker-compose.aws.yml --env-file .env.prod up -d

# --- Public hostnames -------------------------------------------------------
# Use two hostnames under the same parent domain so auth cookies are same-site.
WEB_DOMAIN=osdtype.example.com
API_DOMAIN=api.osdtype.example.com
PUBLIC_ORIGIN=https://osdtype.example.com
PUBLIC_API_URL=https://api.osdtype.example.com
VITE_APP_VERSION=v0.0.1

# --- Container images -------------------------------------------------------
# Set by the GitHub Actions deploy job / EC2 setup.
ECR_REGISTRY=123456789012.dkr.ecr.ap-southeast-2.amazonaws.com
IMAGE_TAG=latest

# --- Supabase Postgres ------------------------------------------------------
# Session pooler on 5432, not transaction pooler on 6543.
# Percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_SSLMODE=require
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5

# --- Managed Redis ----------------------------------------------------------
# rediss:// enables TLS automatically. REDIS_TLS=true is only needed when the
# provider gives you a plain redis:// URL plus a separate TLS toggle.
REDIS_URL=rediss://default:<password>@<host>:<port>
# REDIS_TLS=true

# --- Application secrets ----------------------------------------------------
# openssl rand -hex 32
JWTKEY=replace-with-64-hex-characters

# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps)
GITHUB_KEY=replace-with-client-id
GITHUB_AUTH=replace-with-client-secret
GITHUB_REDIRECT_URL=https://api.osdtype.example.com/auth/github/callback

# Long random bearer token for /metrics. Leave empty only if metrics are
# intentionally public.
METRICS_TOKEN=replace-with-long-random-token

# Optional Discord/Slack webhook for bug reports.
BUG_WEBHOOK_URL=

# Primary admin account. This account is always admin and cannot be demoted.
ADMIN_USERNAME=ItsArnavSh

# Same parent domain: lax. Different registrable domains: none.
COOKIE_SAMESITE=lax
