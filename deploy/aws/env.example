# Production environment template for the single AWS VM deployment.
# Copy this file to .env.prod, fill in real values, then upload it to SSM:
#
#   cp deploy/aws/env.example .env.prod
#   chmod 600 .env.prod
#   ./deploy/aws/upload-env.sh
#
# Never commit .env.prod. Never paste these values into a chat, issue or log.

# --- Public hostnames -------------------------------------------------------
# Vercel remains the public frontend. The API and the optional AWS web fallback
# are served by Caddy on the EC2 instance.
WEB_DOMAIN=app.15.134.14.153.sslip.io
API_DOMAIN=api.15.134.14.153.sslip.io
PUBLIC_ORIGIN=https://osdtype-w5vr-six.vercel.app
PUBLIC_API_URL=https://api.15.134.14.153.sslip.io
VITE_APP_VERSION=v0.0.1

# --- Container images -------------------------------------------------------
# Set by the GitHub Actions deploy job / EC2 setup.
ECR_REGISTRY=123456789012.dkr.ecr.ap-southeast-2.amazonaws.com
IMAGE_TAG=latest

# --- Local PostgreSQL (runs in Docker on the same VM) -----------------------
# The compose file constructs DATABASE_URL from these values; the database is
# not published on the host and never leaves the private Compose network.
# openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-64-hex-characters
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5

# --- Local Redis (runs in Docker on the same VM) ----------------------------
# Again, the compose file constructs REDIS_URL. No TLS is needed because this
# traffic never leaves the Docker bridge network; Redis is password-protected
# and has AOF persistence enabled.
# openssl rand -hex 32
REDIS_PASSWORD=replace-with-64-hex-characters

# --- Application secrets ----------------------------------------------------
# openssl rand -hex 32
JWTKEY=replace-with-64-hex-characters

# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps)
GITHUB_KEY=replace-with-client-id
GITHUB_AUTH=replace-with-client-secret
GITHUB_REDIRECT_URL=https://api.15.134.14.153.sslip.io/auth/github/callback

# Long random bearer token for /metrics. Leave empty only if metrics are
# intentionally public.
METRICS_TOKEN=replace-with-long-random-token

# Optional Discord/Slack webhook for bug reports.
BUG_WEBHOOK_URL=

# Primary admin account. This account is always admin and cannot be demoted.
ADMIN_USERNAME=ItsArnavSh

# Vercel frontend -> AWS API is cross-site, so use none + secure.
# If you later serve the frontend from the same parent domain as the API,
# change this to lax.
COOKIE_SAMESITE=none
COOKIE_SECURE=true
